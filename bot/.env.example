# Discord Developer Portal → 앱 → Bot → Reset Token 으로 받은 토큰
DISCORD_TOKEN=여기에_봇_토큰
# (선택) 테스트 서버 ID — 넣으면 명령어가 즉시 등록됩니다
GUILD_ID=
# 채널 이름에 포함되면 감지 (이름 또는 ID, 쉼표로 여러 개, * 은 모든 채널)
# 도감번호(111, 888-2) 를 받을 채널
DEX_CHANNELS=포켓몬개체정보방
# 배틀 도감번호(배틀111) 를 받을 채널
PVP_CHANNELS=배틀개체정보방
# 도감번호·이름으로 획득 경로를 보여 줄 채널
ACQ_CHANNELS=포켓몬획득정보
# 현재일정 / 다음일정 을 받을 채널
SCHEDULE_CHANNELS=포켓몬고일정
# 친코등록 / 친코확인 을 받을 채널
FRIEND_CHANNELS=친코등록
# 새 멤버 환영 메시지를 올릴 채널 (SERVER MEMBERS INTENT 필요)
NOTICE_CHANNELS=공지
# (권장) 친구 코드 암호화 키 — 아무 긴 문자열. 없으면 봇 토큰 사용
FRIEND_CODE_SECRET=
# '배틀신청 닉네임' 을 받을 채널 (이름에 포함되면 감지)
BATTLE_CHANNELS=배틀신청
# (선택) 웹훅으로 결과만 보낼 때 — 채널 설정 → 연동 → 웹후크
WEBHOOK_URL=
